{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowJs": true,
    "allowImportingTsExtensions": true,
    "checkJs": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [
      "node",
      "vite/client"
    ],
    "resolveJsonModule": true,
    "jsx": "react-jsx"
  },
  "include": [
    "vite.config.ts",
    "src/world-math.js",
    "src/auth-ui.ts",
    "src/worlds-ui.ts",
    "src/password-validation.js",
    "src/net/api.ts",
    "tests/auth.e2e.spec.ts",
    "tests/worlds.e2e.spec.ts",
    "playwright.config.ts",
    "src/world/**/*.ts",
    "tests/map.test.ts",
    "src/world.js",
    "src/features/lobby/**/*.tsx",
    "src/features/history/**/*.tsx",
    "src/features/penalty/**/*.ts",
    "src/features/penalty/**/*.tsx",
    "tests/penalty-duel.test.ts",
    "src/features/race/**/*.ts",
    "src/features/race/**/*.tsx",
    "tests/race.test.ts",
    "src/features/leaderboard/**/*.ts",
    "src/features/leaderboard/**/*.tsx",
    "tests/leaderboard.test.ts",
    "tests/leaderboard.e2e.spec.ts",
    "src/features/voice/**/*.ts",
    "src/features/voice/**/*.tsx",
    "tests/voice.test.ts",
    "tests/voice.guest.e2e.spec.ts",
    "src/guest/**/*.ts",
    "src/features/settings/**/*.tsx",
    "src/features/duck/**/*.ts",
    "src/features/duck/**/*.tsx",
    "tests/guest*.ts",
    "tests/account*.ts",
    "src/auth-state.ts",
    "src/preferences.ts",
    "tests/settings.test.ts",
    "src/audio/**/*.ts",
    "src/ui/**/*.ts",
    "tests/audio.test.ts",
    "tests/activities-performance.fixture.ts",
    "tests/world-ui.e2e.spec.ts",
    "tests/app-shell.test.ts",
    "src/activities/**/*.ts",
    "src/activities/**/*.tsx",
    "tests/activities.test.ts",
    "tests/vehicles.test.ts",
    "tests/football.test.ts",
    "tests/pingpong.test.ts",
    "src/features/pingpong/**/*.ts",
    "src/features/pingpong/**/*.tsx",
    "tests/activity-contract.test.ts",
    "src/guest/lifecycle.ts"
  ]
}
