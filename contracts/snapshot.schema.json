{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Private world full snapshot v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "worldId",
    "selfId",
    "sessionId",
    "mapId",
    "mapChecksum",
    "rulesId",
    "rulesChecksum",
    "epoch",
    "tick",
    "timeMs",
    "protocolVersion",
    "avatars"
  ],
  "properties": {
    "worldId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "selfId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "sessionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "mapId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "mapChecksum": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "rulesId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "rulesChecksum": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "epoch": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "tick": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "timeMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "protocolVersion": {
      "const": 2
    },
    "avatars": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "status",
          "x",
          "y",
          "seq"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "status": {
            "enum": [
              "available",
              "playing",
              "AFK",
              "voice"
            ]
          },
          "x": {
            "type": "number",
            "minimum": 0,
            "maximum": 63
          },
          "y": {
            "type": "number",
            "minimum": 0,
            "maximum": 63
          },
          "seq": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        }
      }
    }
  }
}
