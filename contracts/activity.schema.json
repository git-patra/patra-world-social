{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://patra.world/contracts/activity.schema.json",
  "title": "Activity snapshot protocol 2",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "worldId",
        "areaId",
        "incarnation",
        "generation",
        "serverTimeMs",
        "tick",
        "kind",
        "payload"
      ],
      "properties": {
        "worldId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "areaId": {
          "enum": [
            "race",
            "penalty",
            "pingpong",
            "blaster"
          ]
        },
        "incarnation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "generation": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "serverTimeMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "tick": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "kind": {
          "const": "area"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "phase",
            "matchId",
            "startsAt",
            "clearAt",
            "resetAt"
          ],
          "properties": {
            "phase": {
              "enum": [
                "OPEN",
                "CLEARING",
                "RESERVED",
                "ACTIVE",
                "RESETTING"
              ]
            },
            "matchId": {
              "type": "string",
              "maxLength": 128
            },
            "startsAt": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "clearAt": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "resetAt": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "payload": {
                "properties": {
                  "phase": {
                    "const": "OPEN"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "payload": {
                "properties": {
                  "matchId": {
                    "const": ""
                  }
                }
              }
            }
          },
          "else": {
            "properties": {
              "generation": {
                "minimum": 1
              },
              "payload": {
                "properties": {
                  "matchId": {
                    "minLength": 1
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "payload": {
                "properties": {
                  "phase": {
                    "const": "CLEARING"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "payload": {
                "properties": {
                  "clearAt": {
                    "minimum": 1
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "payload": {
                "properties": {
                  "phase": {
                    "const": "ACTIVE"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "payload": {
                "properties": {
                  "startsAt": {
                    "minimum": 1
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "payload": {
                "properties": {
                  "phase": {
                    "const": "RESETTING"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "payload": {
                "properties": {
                  "resetAt": {
                    "minimum": 1
                  }
                }
              }
            }
          }
        }
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "worldId",
        "areaId",
        "incarnation",
        "generation",
        "serverTimeMs",
        "tick",
        "kind",
        "payload"
      ],
      "properties": {
        "worldId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "areaId": {
          "const": "race"
        },
        "incarnation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "generation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "serverTimeMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "tick": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "kind": {
          "const": "vehicles"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "vehicles"
          ],
          "properties": {
            "vehicles": {
              "type": "array",
              "minItems": 4,
              "maxItems": 4,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "kind",
                  "generation",
                  "riderId",
                  "x",
                  "y",
                  "heading"
                ],
                "properties": {
                  "id": {
                    "enum": [
                      "bicycle-0",
                      "bicycle-1",
                      "car-2",
                      "car-3"
                    ]
                  },
                  "kind": {
                    "enum": [
                      "bicycle",
                      "car"
                    ]
                  },
                  "generation": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9007199254740991
                  },
                  "riderId": {
                    "type": "string",
                    "maxLength": 128
                  },
                  "x": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 63
                  },
                  "y": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 63
                  },
                  "heading": {
                    "type": "number",
                    "minimum": -180,
                    "maximum": 180
                  }
                },
                "allOf": [
                  {
                    "if": {
                      "properties": {
                        "id": {
                          "enum": [
                            "bicycle-0",
                            "bicycle-1"
                          ]
                        }
                      }
                    },
                    "then": {
                      "properties": {
                        "kind": {
                          "const": "bicycle"
                        }
                      }
                    },
                    "else": {
                      "properties": {
                        "kind": {
                          "const": "car"
                        }
                      }
                    }
                  }
                ]
              },
              "allOf": [
                {
                  "contains": {
                    "properties": {
                      "id": {
                        "const": "bicycle-0"
                      }
                    },
                    "required": [
                      "id"
                    ]
                  },
                  "minContains": 1,
                  "maxContains": 1
                },
                {
                  "contains": {
                    "properties": {
                      "id": {
                        "const": "bicycle-1"
                      }
                    },
                    "required": [
                      "id"
                    ]
                  },
                  "minContains": 1,
                  "maxContains": 1
                },
                {
                  "contains": {
                    "properties": {
                      "id": {
                        "const": "car-2"
                      }
                    },
                    "required": [
                      "id"
                    ]
                  },
                  "minContains": 1,
                  "maxContains": 1
                },
                {
                  "contains": {
                    "properties": {
                      "id": {
                        "const": "car-3"
                      }
                    },
                    "required": [
                      "id"
                    ]
                  },
                  "minContains": 1,
                  "maxContains": 1
                }
              ]
            }
          }
        }
      }
    }
  ]
}
