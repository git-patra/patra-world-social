{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Public server event envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "v",
    "eventId",
    "serverTick",
    "serverTimeMs",
    "type",
    "payload"
  ],
  "properties": {
    "v": {
      "const": 1
    },
    "eventId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "serverTick": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "serverTimeMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "type": {
      "enum": [
        "world.snapshot",
        "presence.changed",
        "world.delta",
        "command.ack",
        "lobby.updated",
        "match.started",
        "race.snapshot",
        "race.finished",
        "penalty.choice_ack",
        "penalty.turn_opened",
        "penalty.revealed",
        "duck.shot_resolved",
        "duck.snapshot",
        "chat.message",
        "chat.deleted",
        "command.error",
        "voice.seat_granted",
        "voice.seat_revoked",
        "match.result_status",
        "penalty.snapshot",
        "duck.finished",
        "leaderboard.changed"
      ]
    },
    "payload": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "match.result_status"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": [
              "matchId",
              "status"
            ],
            "additionalProperties": false,
            "properties": {
              "matchId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "status": {
                "enum": [
                  "finalizing",
                  "unconfirmed",
                  "completed",
                  "aborted_storage",
                  "aborted_server",
                  "abandoned",
                  "unavailable"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "leaderboard.changed"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": [
              "worldId",
              "ruleset",
              "resultId"
            ],
            "additionalProperties": false,
            "properties": {
              "worldId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "ruleset": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "resultId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              }
            }
          }
        }
      }
    }
  ]
}
